<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.8">
  <world name="demo">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="diff_drive">
      <self_collide>false</self_collide>
      <pose>0 0 0.35 0 0 0</pose>
      <include merge="true">
        <uri>package://ros_gz_example_description/models/diff_drive</uri>
      </include>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      </plugin>
    </model>
    <physics name="classroom" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gui fullscreen="false">
      <camera name="user_camera">
        <pose>9 -11 9 0 0.55 2.25</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
    <model name="yellow_obstacle">
      <static>true</static>
      <pose>5 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1 2.5 1.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1 2.5 1.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.95 0.75 0.05 1</ambient>
            <diffuse>0.95 0.75 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="green_obstacle">
      <static>true</static>
      <pose>3 3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.4 1.4 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.4 1.4 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.08 0.40 0.31 1</ambient>
            <diffuse>0.08 0.40 0.31 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="blue_obstacle">
      <static>true</static>
      <pose>-1 4 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2 0.8 0.8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2 0.8 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.45 0.65 1</ambient>
            <diffuse>0.12 0.45 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="front_wall">
      <static>true</static>
      <pose>9 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.3 16 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.3 16 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.40 0.43 1</ambient>
            <diffuse>0.35 0.40 0.43 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="rear_wall">
      <static>true</static>
      <pose>-5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.3 16 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.3 16 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.40 0.43 1</ambient>
            <diffuse>0.35 0.40 0.43 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="left_wall">
      <static>true</static>
      <pose>2 8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>14 0.3 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>14 0.3 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.40 0.43 1</ambient>
            <diffuse>0.35 0.40 0.43 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="right_wall">
      <static>true</static>
      <pose>2 -8 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>14 0.3 1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>14 0.3 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.40 0.43 1</ambient>
            <diffuse>0.35 0.40 0.43 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>